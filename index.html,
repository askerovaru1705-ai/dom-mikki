function createProfile(){resetScroll();app.innerHTML=`<section class="screen"><div class="top"><button class="pill" onclick="profile()">← Назад</button></div><div class="bunny">🐰</div><h1 style="font-size:44px">Новый игрок</h1><div class="card"><input id="newName" maxlength="18" placeholder="Имя ребёнка" style="font-size:28px;padding:16px;border-radius:22px;border:2px solid #d9dfd0;width:90%;text-align:center"><div style="font-size:26px;margin:18px 0 10px">Возраст</div><select id="newAge" style="font-size:24px;padding:12px;border-radius:18px;width:90%"><option value="1.5">1–2 года</option><option value="2.5">2–3 года</option><option value="3.5">3–4 года</option><option value="4.5">4–5 лет</option><option value="5.5">5–6 лет</option></select><div style="font-size:26px;margin:18px 0 10px">Выбери аватар</div><div style="display:flex;justify-content:center;gap:14px;flex-wrap:wrap"><button class="pill" onclick="pickAvatar('🐰')">🐰</button><button class="pill" onclick="pickAvatar('🐰')">🐰</button><button class="pill" onclick="pickAvatar('🦊')">🦊</button></div><div id="avatarChoice" style="font-size:60px;margin:12px">🐰</div></div><div class="card" style="font-size:20px;text-align:left"><b>♿ Настройки доступности</b><br><label><input type="checkbox" id="accLarge"> Крупные кнопки</label><br><label><input type="checkbox" id="accCalm"> Спокойный режим без лишних эффектов</label><br><label><input type="checkbox" id="accVisual"> Дублировать важные инструкции визуально</label><br><label><input type="checkbox" id="accAudio"> Дублировать важные инструкции озвучкой</label><br><label><input type="checkbox" id="accSimple"> Упрощённые задания</label></div><button class="primary" style="font-size:34px" onclick="saveNewProfile()">Создать профиль</button></section>`;window.newAvatar='🐰'}
function pickAvatar(a){window.newAvatar=a;const el=document.getElementById('avatarChoice');if(el)el.textContent=a}
function saveNewProfile(){const input=document.getElementById('newName'),name=(input?.value||'').trim();if(!name){speak('Напиши имя ребёнка');input?.focus();return}let id='p'+Date.now();profiles[id]={name,age:parseFloat(document.getElementById('newAge')?.value||'3'),avatar:window.newAvatar||'🐰',stars:0,unlocked:1,accessibility:{large:!!document.getElementById('accLarge')?.checked,calm:!!document.getElementById('accCalm')?.checked,visual:!!document.getElementById('accVisual')?.checked,audio:!!document.getElementById('accAudio')?.checked,simple:!!document.getElementById('accSimple')?.checked}};currentProfile=id;localStorage.setItem('mikkiCurrentProfile',id);saveProfiles();profile()}
function deleteProfile(id){if(Object.keys(profiles).length<=1){speak('Нельзя удалить последний профиль');return}const name=profiles[id].name;if(confirm('Удалить профиль '+name+'?')){delete profiles[id];if(currentProfile===id)currentProfile=Object.keys(profiles)[0];localStorage.setItem('mikkiCurrentProfile',currentProfile);saveProfiles();profile()}}
