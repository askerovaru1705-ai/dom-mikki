 const render=()=>{const x=steps[step];resetScroll();app.innerHTML=`<section class="screen ${ageClass()} shared-story"><div class="top"><button class="pill" onclick="map()">← Мир</button><button class="pill" onclick="toggle()">${sound?'🔊':'🔇'}</button></div><div class="card story-scene"><div class="story-hero character friend">${x[0]}</div><div class="story-weather">${worldSeason().icon} ${worldSeason().weather}</div><h1 style="font-size:42px">${x[1]}</h1><p style="font-size:25px">${x[2]}</p><button class="primary" style="font-size:29px" onclick="sharedStoryNext()">${x[3]} ${x[4]}</button><div class="progress">История ${step+1} из ${steps.length}</div></div><div class="card small">💛 Можно играть вместе с родителем или просто наблюдать. Здесь нет неправильных ответов.</div></section>`;speak(x[2]);window.sharedStoryNext=()=>{step++;if(step<steps.length)render();else{resetScroll();app.innerHTML=`<section class="screen final"><div class="bunny mikki">${rabbitArt('mikki')}</div><h1 style="font-size:48px">Как здорово вместе! 🌈</h1><div class="card" style="font-size:26px">Друзья провели день вместе. А завтра у каждого снова будет своя жизнь.</div><button class="primary" onclick="map()">Вернуться в мир 🗺️</button></section>`;confetti();speak('Как здорово вместе!')}}};
 render();
}
function visitPlace(name){ speak('Пойдём в '+name); freePlay(); }
function updateWorldWeather(){ const el=document.getElementById('worldWeather'); if(!el)return; const m=new Date().getMonth(); const season=m<2||m===11?'зима':m<5?'весна':m<8?'лето':'осень'; const texts={зима:'Сегодня в мире Микки морозно и тихо ❄️',весна:'Сегодня в мире Микки свежо, цветут цветы 🌸',лето:'Сегодня в мире Микки солнечно и тепло ☀️',осень:'Сегодня в мире Микки прохладно, листья шуршат 🍂'}; el.textContent=texts[season]; }
setTimeout(updateWorldWeather,50);

const SHOP_KEY='mikkiShop';
function shopState(){let x={coins:12,inventory:[],gifts:0};try{x={...x,...JSON.parse(localStorage.getItem(SHOP_KEY)||'{}')}}catch(e){}return x}
function saveShop(x){localStorage.setItem(SHOP_KEY,JSON.stringify(x))}
function shop(){const st=shopState();resetScroll();app.innerHTML=`<section class="screen ${ageClass()}"><div class="top"><button class="pill" onclick="map()">← Мир</button><span class="wallet">🪙 ${st.coins}</span></div><div class="bunny mikki">${rabbitArt('mikki')}</div><h1 style="font-size:48px">Маленький городок</h1><div class="card" style="font-size:23px">Здесь герои покупают вещи для своей жизни, праздников и подарков. Можно просто погулять по магазинчикам. 🛍️</div><div class="shop-center"><div class="shop-grid"><button class="shop-card" onclick="shopStore('bakery')"><span class="shop-icon">🧁</span>Кондитерская</button><button class="shop-card" onclick="shopStore('flowers')"><span class="shop-icon">🌷</span>Цветочный</button><button class="shop-card" onclick="shopStore('toys')"><span class="shop-icon">🧸</span>Игрушки</button><button class="shop-card" onclick="shopStore('clothes')"><span class="shop-icon">👕</span>Одежда</button><button class="shop-card" onclick="shopStore('food')"><span class="shop-icon">🥕</span>Продукты</button><button class="shop-card" onclick="shopStore('books')"><span class="shop-icon">📚</span>Книжный</button></div></div><div class="card"><div id="shopMessage" class="shop-message">Микки сегодня заглянул в городок. Куда пойдём?</div><button class="primary" style="font-size:30px" onclick="shopStore('bakery')">🎂 Посмотреть тортики</button></div><button class="secondary" onclick="map()">Вернуться в мир</button></section>`}
const shopData={bakery:{title:'🧁 Кондитерская',items:[['🎂','Торт','8'],['🧁','Кекс','3'],['🍪','Печенье','2']]},flowers:{title:'🌷 Цветочный магазин',items:[['💐','Букет','5'],['🌻','Подсолнух','3'],['🌷','Тюльпаны','4']]},toys:{title:'🧸 Игрушечный магазин',items:[['🧸','Мишка','7'],['🚗','Машинка','6'],['🪁','Воздушный змей','4']]},clothes:{title:'👕 Одежда',items:[['🧢','Кепка','4'],['👗','Платье','7'],['🎒','Рюкзак','6']]},food:{title:'🥕 Продукты',items:[['🍎','Яблоки','2'],['🥛','Молоко','2'],['🍞','Хлеб','2']]},books:{title:'📚 Книжный',items:[['📖','История','5'],['🖍️','Раскраска','3'],['🧩','Книга-игра','6']]}};
function shopStore(kind){const d=shopData[kind];const st=shopState();resetScroll();app.innerHTML=`<section class="screen ${ageClass()}"><div class="top"><button class="pill" onclick="shop()">← Магазинчики</button><span class="wallet">🪙 ${st.coins}</span></div><div class="card"><div class="bunny">${kind==='bakery'?'🐰':'🛍️'}</div><h1 style="font-size:42px">${d.title}</h1><div class="shop-product-grid">${d.items.map((it,i)=>`<div class="shop-product"><b>${it[0]}</b>${it[1]}<small>🪙 ${it[2]}</small><button class="buy-btn" ${st.coins<Number(it[2])?'disabled':''} onclick="buyShopItem('${kind}',${i})">Купить</button></div>`).join('')}</div><div id="shopMessage" class="shop-message">Можно выбрать что-нибудь для дома или в подарок. 💛</div></div><button class="secondary" onclick="shop()">Другой магазин</button></section>`}
function buyShopItem(kind,i){const d=shopData[kind],it=d.items[i],st=shopState(),cost=Number(it[2]);if(st.coins<cost){document.getElementById('shopMessage').textContent='Пока не хватает монеток. Ничего страшного — можно вернуться позже. 💛';speak('Пока не хватает монеток');return}st.coins-=cost;st.inventory.push(it[1]);if(kind==='bakery'&&i===0)st.gifts=(st.gifts||0)+1;saveShop(st);const m=document.getElementById('shopMessage');m.innerHTML=`<span class="gift-box">${it[0]}</span><br>Микки купил: ${it[1]}! 🥰<br><span class="small">Осталось 🪙 ${st.coins}</span>`;speak(kind==='bakery'&&i===0?'Тортик готов! Понесём его на праздник!':'Отличный выбор!');setTimeout(()=>shopStore(kind),900)}


function vacation(){resetScroll();app.innerHTML=`<section class="screen ${ageClass()} vacation-screen"><div class="top"><button class="pill" onclick="map()">← Мир</button><span class="wallet">🪙 ${shopState().coins}</span></div><div class="vacation-hero"><div class="vacation-big">👵🌿🎣</div><h1>Каникулы у бабушки</h1><p>Здесь свои дела: сад, ягоды, озеро и тихие вечера. Можно просто погулять. 💛</p></div><div class="vacation-scene"><div>🏡</div><div>🌳 🍎 🍓 🌻</div><div>🐔 🧺 🚲</div><div>🌊 🐟 🎣</div></div><div class="vacation-actions"><button class="primary" onclick="openLevel('vacation1')">🌿 Начать маленькое приключение</button><button class="secondary" onclick="openLevel('vacation6')">🎣 Пойти на рыбалку</button><button class="secondary" onclick="map()">Вернуться в мир</button></div></section>`;speak('Приехали к бабушке на дачу!');}

/* --- WORLD EVENTS & CELEBRATIONS --- */
const eventStateKey='mikkiWorldEvents';
function eventState(){try{return JSON.parse(localStorage.getItem(eventStateKey)||'{}')}catch(e){return {}}}
function saveEventState(x){localStorage.setItem(eventStateKey,JSON.stringify(x))}
function todayKey(){const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}
function currentWorldEvent(){
  const d=new Date(), st=eventState(), key=todayKey();
  if(st.day===key && st.event) return st.event;
  const events=[
    {type:'birthday',icon:'🎂',title:'День рождения',text:'Сегодня у одного из друзей день рождения. В городке зажглись гирлянды!',action:'Отнести подарок и торт'},
    {type:'rainbow',icon:'🌈',title:'Радуга после дождя',text:'Дождик закончился, и над городком появилась радуга.',action:'Пойти посмотреть'},
    {type:'park',icon:'🌳',title:'День в парке',text:'Друзья собрались в парке: кто-то рисует, кто-то играет, а кто-то слушает птиц.',action:'Пойти в парк'},
    {type:'firstsnow',icon:'❄️',title:'Первый снег',text:'Сегодня выпал первый снег. Все выбежали посмотреть на него.',action:'Выйти во двор'}
  ];
  const month=d.getMonth();
  let pool=events;
  if(month>=11||month<=1) pool=events.filter(e=>e.type!=='rainbow');
  if(month>=2&&month<=4) pool=events.filter(e=>e.type!=='firstsnow');
  const event=pool[(d.getDate()+d.getMonth())%pool.length];
  saveEventState({day:key,event}); return event;
}
function eventBanner(){
  const e=currentWorldEvent();
  return `<div class="world-event" onclick="worldEvent()"><span class="event-bounce">${e.icon}</span><div><b>${e.title}</b><small>${e.text}</small></div><span class="event-arrow">›</span></div>`;
}
function worldEvent(){
  const e=currentWorldEvent();
  resetScroll();app.innerHTML=`<section class="screen ${ageClass()} event-screen"><div class="top"><button class="pill" onclick="map()">← Мир</button><span class="wallet">🪙 ${shopState().coins}</span></div><div class="event-hero"><div class="event-big">${e.icon}</div><h1>${e.title}</h1><p>${e.text}</p></div><div class="event-scene">${eventScene(e)}</div><div class="event-actions"><button class="primary" onclick="eventAction('${e.type}')">${e.action} ✨</button><button class="secondary" onclick="map()">Потом</button></div></section>`;
  speak(e.text);
}
function eventScene(e){
  if(e.type==='birthday') return `<div class="event-house">🏠</div><div class="event-people">🐰 🎨 🐰 🐰</div><div class="event-party">🎈 🎂 🎁 🎈</div>`;
  if(e.type==='rainbow') return `<div class="event-sky">🌦️ 🌈 ☁️</div><div class="event-people">🐰 🐰 🐶</div><div class="event-ground">🌷 🌼 🌱</div>`;
  if(e.type==='park') return `<div class="event-sky">☀️ ☁️ 🦋</div><div class="event-people">🐰 🎨 🐰 🐰</div><div class="event-ground">🌳 🌷 🐶 ⚽</div>`;
  return `<div class="event-sky">❄️ ☁️ ❄️</div><div class="event-people">🐰 🧣 🎨 🐰</div><div class="event-ground">☃️ ❄️ 🛷</div>`;
}
function eventAction(type){
  const st=shopState();
  if(type==='birthday' && (st.gifts||0)>0){st.gifts--;saveShop(st);speak('Подарок готов! Пойдём поздравим друга! 🎁');}
  else if(type==='birthday'){speak('Можно заглянуть в магазин и выбрать подарок или тортик. 🎂');}
  else speak(type==='park'?'Пойдём к друзьям в парк! 🌳':type==='rainbow'?'Смотри, какая радуга! 🌈':'Пойдём посмотрим на снег! ❄️');
  setTimeout(()=>worldEvent(),700);
}
const _oldMap=map;
map=function(){
  _oldMap();
  setTimeout(()=>{const host=document.querySelector('.map-actions'); if(host && !document.querySelector('.world-event')) host.insertAdjacentHTML('beforebegin',eventBanner());},0);
};

</script></body></html>
